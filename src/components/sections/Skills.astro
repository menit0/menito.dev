---
import SkillTag from "@components/SkillTag.astro";
import ReactIcon from "@components/icons/ReactIcon.astro";
import TypeScriptIcon from "@components/icons/TypeScriptIcon.astro";
import JavaScriptIcon from "@components/icons/JavaScriptIcon.astro";
import HTMLIcon from "@components/icons/HTMLIcon.astro";
import CSSIcon from "@components/icons/CSSIcon.astro";
import SassIcon from "@components/icons/SassIcon.astro";
import TailwindIcon from "@components/icons/TailwindIcon.astro";
import ReduxIcon from "@components/icons/ReduxIcon.astro";
import ZustandIcon from "@components/icons/ZustandIcon.astro";
import VitestIcon from "@components/icons/VitestIcon.astro";
import CypressIcon from "@components/icons/CypressIcon.astro";
import ViteIcon from "@components/icons/ViteIcon.astro";
import WebpackIcon from "@components/icons/WebpackIcon.astro";
import GitIcon from "@components/icons/GitIcon.astro";
import JiraIcon from "@components/icons/JiraIcon.astro";
import FlutterIcon from "@components/icons/FlutterIcon.astro";
import DartIcon from "@components/icons/DartIcon.astro";
import UnityIcon from "@components/icons/UnityIcon.astro";
import CSharpIcon from "@components/icons/CSharpIcon.astro";
import JestIcon from "@components/icons/JestIcon.astro";
import TestingLibraryIcon from "@components/icons/TestingLibraryIcon.astro";
import AstroIcon from "@components/icons/AstroIcon.astro";
import SupabaseIcon from "@components/icons/SupabaseIcon.astro";
import NextJsIcon from "@components/icons/NextJsIcon.astro";
import AngularIcon from "@components/icons/AngularIcon.astro";

const { data } = Astro.props;

const skillConfig = {
  React: ReactIcon,
  TypeScript: TypeScriptIcon,
  JavaScript: JavaScriptIcon,
  "Next.js": NextJsIcon,
  Angular: AngularIcon,
  Astro: AstroIcon,
  HTML: HTMLIcon,
  CSS: CSSIcon,
  Sass: SassIcon,
  "Tailwind CSS": TailwindIcon,
  Redux: ReduxIcon,
  Zustand: ZustandIcon,
  "Testing Library": TestingLibraryIcon,
  Vitest: VitestIcon,
  Jest: JestIcon,
  Cypress: CypressIcon,
  Vite: ViteIcon,
  Webpack: WebpackIcon,
  Supabase: SupabaseIcon,
  Git: GitIcon,
  Jira: JiraIcon,
  Flutter: FlutterIcon,
  Dart: DartIcon,
  Unity: UnityIcon,
  "C#": CSharpIcon,
};
---

<section>
  <h2 class="text-2xl mt-8 mb-6">{data.name}</h2>

  <div class="flex flex-wrap gap-2">
    {
      data.items.map((skill: string) => {
        const Icon =
          skillConfig[skill as keyof typeof skillConfig] ?? ReactIcon;
        return <SkillTag label={skill} icon={Icon} />;
      })
    }
  </div>
</section>
