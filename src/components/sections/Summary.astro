---
import SummaryButton from "../SummaryButton.astro";
import CVIcon from "../icons/CVIcon.astro";
import EmailIcon from "../icons/EmailIcon.astro";
import LinkedInIcon from "../icons/LinkedInIcon.astro";
import CodebergIcon from "../icons/CodebergIcon.astro";
import ColoredText from "@components/ColoredText.astro";

const { data } = Astro.props;

const descriptionParts = data.description.split(/(\[.*?\])/g);

const colorVariants = {
  amber: {
    bg: "bg-amber-200/50 dark:bg-amber-900/50",
    text: "text-amber-900 dark:text-amber-300",
  },
  red: {
    bg: "bg-red-200/40 dark:bg-red-900/50",
    text: "text-red-900 dark:text-red-300",
  },
  blue: {
    bg: "bg-blue-200/40 dark:bg-blue-900/50",
    text: "text-blue-900 dark:text-blue-300",
  },
  rose: { bg: "bg-rose-100/50", text: "text-rose-900" },
  emerald: {
    bg: "bg-emerald-200/40 dark:bg-emerald-900/50",
    text: "text-emerald-900 dark:text-emerald-300",
  },
  violet: {
    bg: "bg-violet-200/40 dark:bg-violet-900/50",
    text: "text-violet-900 dark:text-violet-300",
  },
  yellow: { bg: "bg-yellow-100/50", text: "text-yellow-900" },
  orange: {
    bg: "bg-orange-200/40 dark:bg-orange-900/50",
    text: "text-orange-900 dark:text-orange-300",
  },
  default: { bg: "bg-gray-100/50", text: "text-gray-900" },
};

const linkConfig = {
  CV: {
    icon: CVIcon,
    colorClass:
      "hover:bg-rose-100 hover:text-rose-700 hover:border-rose-200 hover:dark:text-rose-100 hover:dark:bg-rose-500/50 hover:dark:border-rose-400/50",
  },
  Email: {
    icon: EmailIcon,
    colorClass:
      "hover:bg-violet-100 hover:text-violet-700 hover:border-violet-200 hover:dark:text-violet-100 hover:dark:bg-violet-500/50 hover:dark:border-violet-400/50",
  },
  LinkedIn: {
    icon: LinkedInIcon,
    colorClass:
      "hover:bg-blue-100 hover:text-blue-700 hover:border-blue-200 hover:dark:text-blue-100 hover:dark:bg-blue-500/50 hover:dark:border-blue-400/50",
  },
  Codeberg: {
    icon: CodebergIcon,
    colorClass:
      "hover:bg-emerald-100 hover:text-emerald-700 hover:border-emerald-200 hover:dark:text-emerald-100 hover:dark:bg-emerald-500/50 hover:dark:border-emerald-400/50",
  },
};
---

<section>
  <h1 class="text-5xl mb-3">{data.name}</h1>
  <p class="font-medium text-rose-700 dark:text-rose-400 mb-8">{data.title}</p>

  <p class="leading-relaxed whitespace-pre-line mb-8">
    {
      descriptionParts.map((part: string) => {
        if (part.startsWith("[") && part.endsWith("]")) {
          const content = part.slice(1, -1).split("|");
          const text = content[0];
          const colorKey = content[1] as keyof typeof colorVariants;

          const theme = colorVariants[colorKey] || colorVariants.default;

          return (
            <ColoredText
              text={text}
              bgClass={theme.bg}
              textClass={theme.text}
            />
          );
        }
        return part;
      })
    }
  </p>

  <div class="flex flex-wrap gap-3">
    {
      data.links.map((link: { label: string; url: string }) => {
        const config = linkConfig[link.label as keyof typeof linkConfig];
        const Icon = config.icon;
        return (
          <SummaryButton
            url={link.url}
            label={link.label}
            colorClass={config.colorClass}
            icon={Icon}
          />
        );
      })
    }
  </div>
</section>
