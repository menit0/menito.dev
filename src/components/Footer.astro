---
import CodebergIcon from "./icons/CodebergIcon.astro";
import EmailIcon from "./icons/EmailIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
---

<footer
  class="flex border-t border-stone-200 dark:border-zinc-700 items-center justify-between py-4 mt-8"
>
  <div class="flex items-center gap-2">
    <div class="h-3 w-3 rounded-full bg-rose-600 mt-1"></div>
    <div class="h-3 w-3 rounded-full bg-violet-600 mt-1"></div>
    <div class="h-3 w-3 rounded-full bg-blue-600 mt-1"></div>
    <div class="h-3 w-3 rounded-full bg-emerald-600 mt-1"></div>
  </div>
  <div class="flex items-center gap-5">
    <a
      href="mailto:guille.mena@protonmail.com"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-stone-700"
    >
      <EmailIcon className="w-4 h-4" />
    </a>
    <a
      href="https://linkedin.com/in/menito"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-stone-700"
    >
      <LinkedInIcon className="w-4 h-4" />
    </a>
    <a
      href="https://codeberg.org/menito"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-stone-700"
    >
      <CodebergIcon className="w-4 h-4" />
    </a>
  </div>
</footer>
