---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

const { url, label, colorClass, icon: Icon } = Astro.props;

interface Props {
  url: string;
  label: string;
  colorClass: string;
  icon?: AstroComponentFactory;
}
---

<a
  class={`inline-flex items-center gap-2 px-2 py-1 text-sm font-medium rounded-lg bg-stone-100 dark:bg-zinc-800 border border-stone-200 dark:border-zinc-700 transition-color duration-200 ${colorClass}`}
  href={url}
  target="_blank"
  rel="noopener noreferrer"
>
  {Icon && <Icon />}
  <span>{label}</span>
</a>
