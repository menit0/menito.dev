---
import type { Experience } from "src/types/Experience";
import ArrowUpRightIcon from "./icons/ArrowUpRightIcon.astro";

const { experience } = Astro.props;

interface Props {
  experience: Experience;
}
---

<div class="flex gap-4 items-start">
  <img src={`../${experience.icon}`} class="rounded-lg shrink-0" width="45" />
  <div class="flex-1">
    <div class="flex justify-between items-start mb-3">
      <div>
        <h4 class="text-stone-800 dark:text-stone-200 font-medium">
          {experience.title}
        </h4>
        {
          experience.place.url ? (
            <div class="inline-flex items-center group">
              <a
                class="text-stone-400 hover:text-stone-500 dark:text-stone-400 hover:dark:text-stone-300"
                href={experience.place.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {experience.place.name}
              </a>
              <ArrowUpRightIcon class="h-4 w-4 opacity-0 transition-all duration-300 group-hover:opacity-100 text-stone-400 dark:text-stone-300" />
            </div>
          ) : (
            <p class="text-stone-400">{experience.place.name}</p>
          )
        }
      </div>
      <span class="text-sm text-stone-400">{experience.date}</span>
    </div>

    <p class="leading-relaxed">{experience.description}</p>
  </div>
</div>
