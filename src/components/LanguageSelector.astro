---
const { currentLang } = Astro.props;
---

<div class="flex flex-col items-center group">
  <div
    class="invisible h-1 w-1 rounded-full bg-rose-600 mb-1 group-hover:visible"
  >
  </div>
  <a
    href={currentLang === "en" ? "/es" : "/"}
    class="font-bold hover:text-rose-600">{currentLang.toUpperCase()}</a
  >
</div>
